# Twilio Console (console.twilio.com) -> Account -> Auth Token
TWILIO_AUTH_TOKEN=

# See src/ivr/telephony/config.py for why this defaults to off. Set to
# true only once PUBLIC_BASE_URL below is correct for wherever this is
# actually running -- getting it wrong makes every call fail with a 403.
TWILIO_VALIDATE_SIGNATURES=false

# The exact public URL Twilio is configured to call, e.g. a Codespaces
# forwarded-port URL or an ngrok tunnel. Required for the <Gather> callback
# to work reliably at all (see app.py's _gather_action_url), and for
# signature validation above if that's turned on. Update this whenever your
# forwarded URL changes (e.g. after a Codespace restart).
PUBLIC_BASE_URL=

# Phone number to <Dial> on escalation, e.g. +911234567890. Leave blank to
# just speak the escalation message and hang up (no real CSR queue in this
# dev setup).
CSR_TRANSFER_NUMBER=

# How long (seconds) <Gather> waits for the caller to start speaking before
# giving up. Twilio's own default is 5, which can be tight if you pause to
# recall a PIN or account number before speaking.
GATHER_TIMEOUT_SECONDS=8

# How long (seconds) of trailing silence ends a digit-capture prompt
# (MPIN/OTP/account/card) once you've started speaking. Twilio's "auto"
# end-of-speech detection (used everywhere else) can cut off a pause
# mid-recitation, e.g. reading digits in two groups.
GATHER_SPEECH_TIMEOUT_DIGITS=3

# Free API key at https://console.groq.com -- powers real LLM-based intent
# classification (src/ivr/coordinator/llm_intent_classifier.py). Leave
# blank to fall back to keyword-matching intent classification instead
# (still works, just less capable at natural phrasing).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
